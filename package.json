{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Olyce Frontend",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev:main": "next dev",
    "dev:admin": "cd admin && npm run dev -- -p 3001",
    "dev:backend": "cd Backend && npm run dev",
    "dev:all": "concurrently \"npm run dev:main\" \"npm run dev:admin\" \"npm run dev:backend\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/leaflet": "^1.9.21",
    "@vercel/speed-insights": "^1.3.1",
    "autoprefixer": "^10.4.27",
    "axios": "^1.16.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "styled-components": "^6.4.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.2",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  }
}
